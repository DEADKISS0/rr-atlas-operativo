<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="def_flujo_entrada_dinero" targetNamespace="https://rraliados.co/bpmn" exporter="RR Aliados · bpmn_xml_v2.py" exporterVersion="2.0">
  <bpmn:collaboration id="collab_1">
    <bpmn:participant id="part_1" name="CÓMO ENTRA UN PESO A LA CUENTA" processRef="proc_flujo_entrada_dinero"/>
  </bpmn:collaboration>
  <bpmn:process id="proc_flujo_entrada_dinero" name="CÓMO ENTRA UN PESO A LA CUENTA" isExecutable="false">
    <bpmn:documentation>CÓMO ENTRA UN PESO A LA CUENTA
De la firma del contrato a la plata en el banco. · corte 2026-09-26
Dueno del proceso: DESCONOCIDO (el spec no lo declara)
KPI: DESCONOCIDO (el spec no lo declara)
Fuente: _herramientas/esquemas_bpmn/finanzas_como_entra_un_peso_a_la_cuenta.json</bpmn:documentation>
    <bpmn:laneSet id="laneset_1">
      <bpmn:lane id="lane_1" name="1 · Lo que se emite">
        <bpmn:flowNodeRef>e_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_contrato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_factura</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_2" name="2 · Lo que pagan los clientes">
        <bpmn:flowNodeRef>g_paga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cliente_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cliente_c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_caja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_ini" name="Cliente sin firmar">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ed_e_ini"/>
    </bpmn:startEvent>
    <bpmn:task id="t_contrato" name="1. Hay contrato firmado">
      <bpmn:documentation>Sin contrato firmado no hay factura: hay promesa. Hoy 2 clientes sin firmar: CLIENTE_A y CLIENTE_C.</bpmn:documentation>
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_factura" name="2. Se emite la factura">
      <bpmn:documentation>Es el documento que prueba que se facturó. La factura al cliente no es la Cuenta de Cobro al colaborador: son dos documentos distintos.</bpmn:documentation>
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
      <bpmn:property id="prop_t_factura" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="dia_1">
        <bpmn:documentation>los montos</bpmn:documentation>
        <bpmn:sourceRef>d_captura</bpmn:sourceRef>
        <bpmn:targetRef>prop_t_factura</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:parallelGateway id="g_paga" name="3. ¿Pagó el cliente?">
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="t_cliente_a" name="Paga CLIENTE_A">
      <bpmn:documentation>[CIFRA] el 15/10 (2 meses de golpe), luego [CIFRA]/mes hasta febrero. Contrato SIN FIRMAR.</bpmn:documentation>
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_cliente_c" name="Paga CLIENTE_C">
      <bpmn:documentation>[CIFRA]/mes. Contrato SIN FIRMAR.</bpmn:documentation>
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_cand" name="Paga CLIENTE_B">
      <bpmn:documentation>[CIFRA]/mes del 15/10/2026 al 15/05/2027. El único de los tres con contrato firmado.</bpmn:documentation>
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:outgoing>sf_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_caja" name="Entra a la cuenta">
      <bpmn:documentation>Cartera vencida: [CIFRA] Nadie nos debe hoy.</bpmn:documentation>
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:incoming>sf_9</bpmn:incoming>
      <bpmn:outgoing>sf_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e_fin" name="En la cuenta">
      <bpmn:incoming>sf_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="d_captura" name="captura.json">
      <bpmn:documentation>Almacén · de aquí salen los montos.</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="sf_1" sourceRef="e_ini" targetRef="t_contrato"/>
    <bpmn:sequenceFlow id="sf_2" sourceRef="t_contrato" targetRef="t_factura"/>
    <bpmn:sequenceFlow id="sf_3" sourceRef="t_factura" targetRef="g_paga" name="a fin de mes"/>
    <bpmn:sequenceFlow id="sf_4" sourceRef="g_paga" targetRef="t_cliente_a"/>
    <bpmn:sequenceFlow id="sf_5" sourceRef="g_paga" targetRef="t_cliente_c"/>
    <bpmn:sequenceFlow id="sf_6" sourceRef="g_paga" targetRef="t_cand"/>
    <bpmn:sequenceFlow id="sf_7" sourceRef="t_cliente_a" targetRef="t_caja"/>
    <bpmn:sequenceFlow id="sf_8" sourceRef="t_cliente_c" targetRef="t_caja"/>
    <bpmn:sequenceFlow id="sf_9" sourceRef="t_cand" targetRef="t_caja"/>
    <bpmn:sequenceFlow id="sf_10" sourceRef="t_caja" targetRef="e_fin"/>
    <bpmn:textAnnotation id="nota_1">
      <bpmn:text>ESTO FRENA LA QUINCENA: sin firma no hay factura que emitir, y el 15/10 entran [CIFRA] que hoy no están respaldados por un documento firmado.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_1" sourceRef="nota_1" targetRef="t_contrato"/>
    <bpmn:textAnnotation id="nota_2">
      <bpmn:text>CLIENTE_B paga el 12/10: un día después del fondo (15/10). No cubre octubre, y es la primera quincena sin respaldo de CLIENTE_A.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_2" sourceRef="nota_2" targetRef="t_cand"/>
    <bpmn:textAnnotation id="nota_3">
      <bpmn:text>LO QUE NO ES ENTRADA DE CAJA: las 3 Cuentas de Cobro sin firmar por [CIFRA] (PERSONA_4 [CIFRA], PERSONA_3 [CIFRA], PERSONA_2 [CIFRA]) son cuentas POR PAGAR de RR Aliados a colaboradores, no cobros de clientes. Viven en 03_09_flujo_pago_colaborador.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_3" sourceRef="nota_3" targetRef="t_caja"/>
  </bpmn:process>
