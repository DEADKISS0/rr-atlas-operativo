<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="def_flujo_legal" targetNamespace="https://rraliados.co/bpmn" exporter="RR Aliados · bpmn_xml_v2.py" exporterVersion="2.0">
  <bpmn:collaboration id="collab_1">
    <bpmn:participant id="part_1" name="CÓMO SE FIRMA UN CONTRATO" processRef="proc_flujo_legal"/>
  </bpmn:collaboration>
  <bpmn:process id="proc_flujo_legal" name="CÓMO SE FIRMA UN CONTRATO" isExecutable="false">
    <bpmn:documentation>CÓMO SE FIRMA UN CONTRATO
Contrato firmado y archivado, con control de renovación. · corte 2026-09-26
Dueno del proceso: DESCONOCIDO (el spec no lo declara)
KPI: DESCONOCIDO (el spec no lo declara)
Fuente: _herramientas/esquemas_bpmn/legal_como_se_firma_un_contrato.json</bpmn:documentation>
    <bpmn:laneSet id="laneset_1">
      <bpmn:lane id="lane_1" name="1 · Legal">
        <bpmn:flowNodeRef>e_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_plantilla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rev_int</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_acliente_cda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_acliente_cda</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_2" name="2 · Dirección">
        <bpmn:flowNodeRef>t_aprueba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_firmado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_firma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_archiva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_renueva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_3" name="3 · Donde se traba"/>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_ini" name="Alguien lo pide">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ed_e_ini"/>
    </bpmn:startEvent>
    <bpmn:task id="t_pide" name="1. Se pide el contrato">
      <bpmn:documentation>Con un cliente o un proveedor. Se hace la solicitud.</bpmn:documentation>
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_plantilla" name="2. Se usa la plantilla">
      <bpmn:documentation>Se parte de la plantilla vigente de 09_Admin/Legal/. No se arma de cero.</bpmn:documentation>
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
      <bpmn:property id="prop_t_plantilla" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="dia_1">
        <bpmn:documentation>las plantillas</bpmn:documentation>
        <bpmn:sourceRef>d_legal</bpmn:sourceRef>
        <bpmn:targetRef>prop_t_plantilla</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t_rev_int" name="3. Revisión interna">
      <bpmn:documentation>Datos, alcance y monto, contra lo que se acordó.</bpmn:documentation>
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_acliente_cda" name="4. ¿Requiere acliente_cda?">
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_acliente_cda" name="Revisión de acliente_cda externa">
      <bpmn:documentation>Cuesta tiempo y plata. La revisión legal NO tiene SLA escrito.</bpmn:documentation>
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_aprueba" name="5. Aprobación de Dirección">
      <bpmn:documentation>Dirección aprueba precio y alcance. EQUIPO_1 decide.</bpmn:documentation>
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_firmado" name="6. ¿Firmaron las dos partes?">
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:incoming>sf_11</bpmn:incoming>
      <bpmn:outgoing>sf_9</bpmn:outgoing>
      <bpmn:outgoing>sf_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_firma" name="Se firma y se devuelve">
      <bpmn:documentation>El cliente firma y devuelve. Se acepta en Drive.</bpmn:documentation>
      <bpmn:incoming>sf_9</bpmn:incoming>
      <bpmn:outgoing>sf_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_archiva" name="7. Archivo en Drive">
      <bpmn:documentation>Se guarda en 09_Admin/CONTRATOS/ con el estado real: firmado o no.</bpmn:documentation>
      <bpmn:incoming>sf_10</bpmn:incoming>
      <bpmn:outgoing>sf_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_renueva" name="8. Control de renovación">
      <bpmn:documentation>Se anota cuándo vence, para recordarlo antes y no después.</bpmn:documentation>
      <bpmn:incoming>sf_12</bpmn:incoming>
      <bpmn:outgoing>sf_13</bpmn:outgoing>
      <bpmn:property id="prop_t_renueva" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="dia_2">
        <bpmn:documentation>qué está archivado</bpmn:documentation>
        <bpmn:sourceRef>d_contratos</bpmn:sourceRef>
        <bpmn:targetRef>prop_t_renueva</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="e_fin" name="Firmado y controlado">
      <bpmn:incoming>sf_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="do_d_contratos"/>
    <bpmn:dataObjectReference id="d_contratos" dataObjectRef="do_d_contratos" name="CONTRATOS/">
      <bpmn:documentation>La carpeta no es la firma: estar ahí no significa firmado. El estado va aparte.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="do_d_legal"/>
    <bpmn:dataObjectReference id="d_legal" dataObjectRef="do_d_legal" name="LEGAL.md">
      <bpmn:documentation>Lo que la función tiene escrito hoy.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:sequenceFlow id="sf_1" sourceRef="e_ini" targetRef="t_pide"/>
    <bpmn:sequenceFlow id="sf_2" sourceRef="t_pide" targetRef="t_plantilla"/>
    <bpmn:sequenceFlow id="sf_3" sourceRef="t_plantilla" targetRef="t_rev_int"/>
    <bpmn:sequenceFlow id="sf_4" sourceRef="t_rev_int" targetRef="g_acliente_cda"/>
    <bpmn:sequenceFlow id="sf_5" sourceRef="g_acliente_cda" targetRef="t_acliente_cda" name="sí"/>
    <bpmn:sequenceFlow id="sf_6" sourceRef="g_acliente_cda" targetRef="t_aprueba" name="no"/>
    <bpmn:sequenceFlow id="sf_7" sourceRef="t_acliente_cda" targetRef="t_aprueba"/>
    <bpmn:sequenceFlow id="sf_8" sourceRef="t_aprueba" targetRef="g_firmado"/>
    <bpmn:sequenceFlow id="sf_9" sourceRef="g_firmado" targetRef="t_firma" name="no"/>
    <bpmn:sequenceFlow id="sf_10" sourceRef="g_firmado" targetRef="t_archiva" name="sí"/>
    <bpmn:sequenceFlow id="sf_11" sourceRef="t_firma" targetRef="g_firmado"/>
    <bpmn:sequenceFlow id="sf_12" sourceRef="t_archiva" targetRef="t_renueva"/>
    <bpmn:sequenceFlow id="sf_13" sourceRef="t_renueva" targetRef="e_fin"/>
    <bpmn:textAnnotation id="nota_1">
      <bpmn:text>Un contrato sin firmar convierte ingreso en promesa. Hoy hay 2 sin firmar: CLIENTE_A y CLIENTE_C. Y el 15/10 de CLIENTE_A son [CIFRA].</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_1" sourceRef="nota_1" targetRef="g_firmado"/>
    <bpmn:textAnnotation id="nota_2">
      <bpmn:text>HUECO: hay contratos de séptimo con fecha de entrega, pero no hay calendario de vencimientos. El control de renovación es el paso 8 y no existe.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_2" sourceRef="nota_2" targetRef="t_renueva"/>
    <bpmn:textAnnotation id="nota_3">
      <bpmn:text>HUECO: no hay índice de plantillas de contrato. No se sabe cuáles están vigentes.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_3" sourceRef="nota_3" targetRef="t_plantilla"/>
    <bpmn:textAnnotation id="nota_4">
      <bpmn:text>Firmado ≠ cobrado. Que el contrato esté firmado no significa que el dinero entró. Eso lo confirma una persona.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_4" sourceRef="nota_4" targetRef="t_archiva"/>
  </bpmn:process>
