<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="def_flujo_informacion" targetNamespace="https://rraliados.co/bpmn" exporter="RR Aliados · bpmn_xml_v2.py" exporterVersion="2.0">
  <bpmn:collaboration id="collab_1">
    <bpmn:participant id="part_1" name="DE DÓNDE SALE LA RESPUESTA" processRef="proc_flujo_informacion"/>
  </bpmn:collaboration>
  <bpmn:process id="proc_flujo_informacion" name="DE DÓNDE SALE LA RESPUESTA" isExecutable="false">
    <bpmn:documentation>DE DÓNDE SALE LA RESPUESTA
El camino que recorre una pregunta desde que se hace hasta que tiene una respuesta con fuente. · corte 2026-09-26
Dueno del proceso: DESCONOCIDO (el spec no lo declara)
KPI: DESCONOCIDO (el spec no lo declara)
Fuente: _herramientas/esquemas_bpmn/informacion_de_donde_sale_la_respuesta.json</bpmn:documentation>
    <bpmn:laneSet id="laneset_1">
      <bpmn:lane id="lane_1" name="1 · La pregunta">
        <bpmn:flowNodeRef>e_ini</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_2" name="2 · La skill decide">
        <bpmn:flowNodeRef>t_ruta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_encuentra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_busca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fuente</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_3" name="3 · La respuesta">
        <bpmn:flowNodeRef>t_responde</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_limite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_notion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_notion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_persona</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_hueco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_alcanza</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_ini" name="Alguien pregunta">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ed_e_ini"/>
    </bpmn:startEvent>
    <bpmn:task id="t_ruta" name="1. rr-consulta decide dónde mirar">
      <bpmn:documentation>La skill lee 00_RUTAS.md y elige la nota correcta. No explora a ciegas.</bpmn:documentation>
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
      <bpmn:property id="prop_t_ruta" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="dia_1">
        <bpmn:documentation>el índice</bpmn:documentation>
        <bpmn:sourceRef>d_rutas</bpmn:sourceRef>
        <bpmn:targetRef>prop_t_ruta</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_encuentra" name="2. ¿Encontró la nota?">
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_busca" name="Si la fuente no está">
      <bpmn:documentation>Se dice DESCONOCIDO y el dato se busca en la fuente real. Acá se inventan cosas.</bpmn:documentation>
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:incoming>sf_11</bpmn:incoming>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_fuente" name="3. La nota fuente">
      <bpmn:documentation>Tiene que decir de dónde salió: fuentes: en el frontmatter, fecha de corte, y el archivo canónico en Drive.</bpmn:documentation>
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_responde" name="4. Se responde con fuente">
      <bpmn:documentation>La respuesta trae el dato, de dónde sale y a qué fecha corresponde.</bpmn:documentation>
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_limite" name="5. Se declara el límite">
      <bpmn:documentation>Si parte de la respuesta no se sabe, se dice. No se completa con un supuesto callado.</bpmn:documentation>
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_notion" name="6. ¿Trae algo de Notion?">
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:outgoing>sf_9</bpmn:outgoing>
      <bpmn:outgoing>sf_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_notion" name="Notion no se usa">
      <bpmn:documentation>Ni se lee, ni se escribe, ni se cita. Decisión del 26/09. Si una respuesta trae datos de Notion, está mal aunque suene bien.</bpmn:documentation>
      <bpmn:incoming>sf_9</bpmn:incoming>
      <bpmn:outgoing>sf_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_persona" name="7. La persona lee">
      <bpmn:documentation>Respuesta corta, con el número y de dónde sale. Si no hay dato, eso es lo que se responde.</bpmn:documentation>
      <bpmn:incoming>sf_10</bpmn:incoming>
      <bpmn:outgoing>sf_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e_fin" name="Respondido con fuente">
      <bpmn:incoming>sf_13</bpmn:incoming>
      <bpmn:incoming>sf_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t_hueco" name="Se anota el hueco">
      <bpmn:documentation>La pregunta no estaba documentada. Se anota en 00_HUECOS.md con la pregunta y a quién preguntarle.</bpmn:documentation>
      <bpmn:incoming>sf_14</bpmn:incoming>
      <bpmn:outgoing>sf_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_alcanza" name="¿Alcanzó la respuesta?">
      <bpmn:incoming>sf_12</bpmn:incoming>
      <bpmn:outgoing>sf_13</bpmn:outgoing>
      <bpmn:outgoing>sf_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataObject id="do_d_rutas"/>
    <bpmn:dataObjectReference id="d_rutas" dataObjectRef="do_d_rutas" name="00_RUTAS.md">
      <bpmn:documentation>La puerta de entrada. Todo entra por esta nota: si algo no está ahí, no existe para quien pregunta.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:sequenceFlow id="sf_1" sourceRef="e_ini" targetRef="t_ruta" name="las dos rutas usan la misma skill"/>
    <bpmn:sequenceFlow id="sf_2" sourceRef="t_ruta" targetRef="g_encuentra"/>
    <bpmn:sequenceFlow id="sf_3" sourceRef="g_encuentra" targetRef="t_busca" name="no"/>
    <bpmn:sequenceFlow id="sf_4" sourceRef="g_encuentra" targetRef="t_fuente" name="sí"/>
    <bpmn:sequenceFlow id="sf_5" sourceRef="t_busca" targetRef="t_fuente"/>
    <bpmn:sequenceFlow id="sf_6" sourceRef="t_fuente" targetRef="t_responde"/>
    <bpmn:sequenceFlow id="sf_7" sourceRef="t_responde" targetRef="t_limite"/>
    <bpmn:sequenceFlow id="sf_8" sourceRef="t_limite" targetRef="g_notion"/>
    <bpmn:sequenceFlow id="sf_9" sourceRef="g_notion" targetRef="t_notion" name="sí: está mal"/>
    <bpmn:sequenceFlow id="sf_10" sourceRef="g_notion" targetRef="t_persona" name="no"/>
    <bpmn:sequenceFlow id="sf_11" sourceRef="t_notion" targetRef="t_busca" name="se rehace"/>
    <bpmn:sequenceFlow id="sf_12" sourceRef="t_persona" targetRef="g_alcanza"/>
    <bpmn:sequenceFlow id="sf_13" sourceRef="g_alcanza" targetRef="e_fin" name="sí"/>
    <bpmn:sequenceFlow id="sf_14" sourceRef="g_alcanza" targetRef="t_hueco" name="no: no estaba documentado"/>
    <bpmn:sequenceFlow id="sf_15" sourceRef="t_hueco" targetRef="e_fin"/>
    <bpmn:textAnnotation id="nota_1">
      <bpmn:text>Si la skill empieza a recorrer el vault, la ruta falló. Leer 00_RUTAS es lo que hace que la respuesta salga en segundos y no en un minuto.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_1" sourceRef="nota_1" targetRef="t_ruta"/>
    <bpmn:textAnnotation id="nota_2">
      <bpmn:text>Si la nota no dice de dónde vino, eso no es una respuesta. Se dice DESCONOCIDO. Regla 1: una fuente por tema. Regla 2: el vault no es la fuente, el dato vive en Drive. Regla 3: sin fecha no hay respuesta. Regla 4: lo que no se sabe se escribe.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_2" sourceRef="nota_2" targetRef="t_busca"/>
    <bpmn:textAnnotation id="nota_3">
      <bpmn:text>La rueda vuelve: el hueco se resuelve, se documenta, y la próxima vez la respuesta ya existe. Un hueco anotado es un trabajo a medio hacer.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_3" sourceRef="nota_3" targetRef="t_hueco"/>
    <bpmn:textAnnotation id="nota_4">
      <bpmn:text>Nueve validadores, cada uno con un trabajo y probado con un error plantado. Ver COMO_VERIFICAR.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_4" sourceRef="nota_4" targetRef="d_rutas"/>
  </bpmn:process>
