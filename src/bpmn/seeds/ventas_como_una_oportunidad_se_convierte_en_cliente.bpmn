<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="def_flujo_comercial" targetNamespace="https://rraliados.co/bpmn" exporter="RR Aliados · bpmn_xml_v2.py" exporterVersion="2.0">
  <bpmn:collaboration id="collab_1">
    <bpmn:participant id="part_1" name="CÓMO UNA OPORTUNIDAD SE CONVIERTE EN CLIENTE" processRef="proc_flujo_comercial"/>
  </bpmn:collaboration>
  <bpmn:process id="proc_flujo_comercial" name="CÓMO UNA OPORTUNIDAD SE CONVIERTE EN CLIENTE" isExecutable="false">
    <bpmn:documentation>CÓMO UNA OPORTUNIDAD SE CONVIERTE EN CLIENTE
Nueve pasos, del primer contacto hasta que el trabajo arranca. El paso 7 es el que más cuesta: la firma. · corte 2026-09-26
Dueno del proceso: DESCONOCIDO (el spec no lo declara)
KPI: DESCONOCIDO (el spec no lo declara)
Fuente: _herramientas/esquemas_bpmn/ventas_como_una_oportunidad_se_convierte_en_cliente.json</bpmn:documentation>
    <bpmn:laneSet id="laneset_1">
      <bpmn:lane id="lane_1" name="1 · Comercial (lleva)">
        <bpmn:flowNodeRef>e_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_anota</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_mira</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_propone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pre</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_2" name="2 · Dirección (aprueba)">
        <bpmn:flowNodeRef>t_negocia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_firma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_firmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_onboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_arranca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_3" name="3 · A quién se le pregunta"/>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_ini" name="Llega alguien">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ed_e_ini"/>
    </bpmn:startEvent>
    <bpmn:task id="t_anota" name="2. Se anota">
      <bpmn:documentation>Entra al listado de posibles clientes con su nombre y cómo llegó. Hoy: CLIENTE_A, CLIENTE_C, CLIENTE_E.</bpmn:documentation>
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_mira" name="3. Se mira qué es">
      <bpmn:documentation>Qué necesita, cuánto vale, si es posible hacerlo y cuánto cuesta.</bpmn:documentation>
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_propone" name="4. Se propone">
      <bpmn:documentation>Un prototipo o una propuesta con precio.</bpmn:documentation>
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
      <bpmn:property id="prop_t_propone" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="dia_1">
        <bpmn:documentation>el embudo</bpmn:documentation>
        <bpmn:sourceRef>d_ventas</bpmn:sourceRef>
        <bpmn:targetRef>prop_t_propone</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t_pre" name="5. Precontrato">
      <bpmn:documentation>Un acuerdo de que van a firmar. Todavía no es el contrato final.</bpmn:documentation>
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_negocia" name="6. Se negocia">
      <bpmn:documentation>Se ajusta precio, alcance o fechas. Ejemplo: CLIENTE_A, [CIFRA] por 2 meses por delante.</bpmn:documentation>
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:incoming>sf_9</bpmn:incoming>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
      <bpmn:property id="prop_t_negocia" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="dia_2">
        <bpmn:documentation>quiénes firman</bpmn:documentation>
        <bpmn:sourceRef>d_manual</bpmn:sourceRef>
        <bpmn:targetRef>prop_t_negocia</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_firma" name="¿Se firmó?">
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_firmar" name="7. Se firma o se aprueba">
      <bpmn:documentation>Sin firma no hay factura. Acá se traba hoy: CLIENTE_A y CLIENTE_C no tienen contrato firmado.</bpmn:documentation>
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:outgoing>sf_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_onboard" name="8. Onboarding">
      <bpmn:documentation>Carpeta del cliente, su _CONTEXTO.md y los entregables escritos. Ver 03_10_flujo_onboarding_cliente.</bpmn:documentation>
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:outgoing>sf_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_arranca" name="9. Arranca el trabajo">
      <bpmn:documentation>Recibe Producción o Desarrollo.</bpmn:documentation>
      <bpmn:incoming>sf_10</bpmn:incoming>
      <bpmn:outgoing>sf_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e_fin" name="Es cliente">
      <bpmn:incoming>sf_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="do_d_ventas"/>
    <bpmn:dataObjectReference id="d_ventas" dataObjectRef="do_d_ventas" name="ventas.md">
      <bpmn:documentation>La fuente del embudo: 13 etapas y 6 segmentos.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="do_d_manual"/>
    <bpmn:dataObjectReference id="d_manual" dataObjectRef="do_d_manual" name="MANUAL_ROLES">
      <bpmn:documentation>Los 5 cargos de planta y 2 sin llenar.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:sequenceFlow id="sf_1" sourceRef="e_ini" targetRef="t_anota"/>
    <bpmn:sequenceFlow id="sf_2" sourceRef="t_anota" targetRef="t_mira" name="se revisa"/>
    <bpmn:sequenceFlow id="sf_3" sourceRef="t_mira" targetRef="t_propone" name="se propone"/>
    <bpmn:sequenceFlow id="sf_4" sourceRef="t_propone" targetRef="t_pre" name="se formaliza"/>
    <bpmn:sequenceFlow id="sf_5" sourceRef="t_pre" targetRef="t_negocia"/>
    <bpmn:sequenceFlow id="sf_6" sourceRef="t_negocia" targetRef="g_firma"/>
    <bpmn:sequenceFlow id="sf_7" sourceRef="g_firma" targetRef="t_firmar" name="no"/>
    <bpmn:sequenceFlow id="sf_8" sourceRef="g_firma" targetRef="t_onboard" name="sí"/>
    <bpmn:sequenceFlow id="sf_9" sourceRef="t_firmar" targetRef="t_negocia" name="se vuelve a negociar"/>
    <bpmn:sequenceFlow id="sf_10" sourceRef="t_onboard" targetRef="t_arranca"/>
    <bpmn:sequenceFlow id="sf_11" sourceRef="t_arranca" targetRef="e_fin"/>
    <bpmn:textAnnotation id="nota_1">
      <bpmn:text>CONTROL ROJO: pagar sin contrato firmado es el error más caro que hay. CLIENTE_A y CLIENTE_C están en esa situación, y el 15/10 de CLIENTE_A son [CIFRA].</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_1" sourceRef="nota_1" targetRef="t_firmar"/>
    <bpmn:textAnnotation id="nota_2">
      <bpmn:text>A quién se le pregunta: Finanzas si puede pagar, Legal por el contrato, Operaciones si es posible.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_2" sourceRef="nota_2" targetRef="g_firma"/>
    <bpmn:textAnnotation id="nota_3">
      <bpmn:text>Corrección 2026-09-26: este lienzo antes decía que 3 de 17 Cuentas de Cobro estaban sin firmar por [CIFRA] como si fueran parte de la firma del cliente. Esas 20 Cuentas de Cobro son cuentas por pagar de RR Aliados a colaboradores, no del cliente. El desbloqueo aquí es el contrato, no una firma de cobranza.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_3" sourceRef="nota_3" targetRef="t_anota"/>
    <bpmn:textAnnotation id="nota_4">
      <bpmn:text>Responsable con nombre: NO APARECE en la fuente. El manual de roles no dice quién lleva comercial. Es un hueco, no un dato.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_4" sourceRef="nota_4" targetRef="t_negocia"/>
  </bpmn:process>
