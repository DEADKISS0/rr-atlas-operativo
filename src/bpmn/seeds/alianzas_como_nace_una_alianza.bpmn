<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="def_flujo_alianzas" targetNamespace="https://rraliados.co/bpmn" exporter="RR Aliados · bpmn_xml_v2.py" exporterVersion="2.0">
  <bpmn:collaboration id="collab_1">
    <bpmn:participant id="part_1" name="CÓMO NACE UNA ALIANZA" processRef="proc_flujo_alianzas"/>
  </bpmn:collaboration>
  <bpmn:process id="proc_flujo_alianzas" name="CÓMO NACE UNA ALIANZA" isExecutable="false">
    <bpmn:documentation>CÓMO NACE UNA ALIANZA
Prospectos que entran por confianza de terceros, sin costo de adquisición. · corte 2026-09-26
Dueno del proceso: DESCONOCIDO (el spec no lo declara)
KPI: DESCONOCIDO (el spec no lo declara)
Fuente: _herramientas/esquemas_bpmn/alianzas_como_nace_una_alianza.json</bpmn:documentation>
    <bpmn:laneSet id="laneset_1">
      <bpmn:lane id="lane_1" name="1 · Alianzas">
        <bpmn:flowNodeRef>e_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_valida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_relacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_acuerdo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_registra</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_2" name="2 · Comercial">
        <bpmn:flowNodeRef>t_llega</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_embudo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_cierra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reporta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_3" name="3 · Lo que no está escrito"/>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_ini" name="Alguien con audiencia">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ed_e_ini"/>
    </bpmn:startEvent>
    <bpmn:task id="t_valida" name="2. Se valida el encaje">
      <bpmn:documentation>Qué clientes tiene, si encaja con lo que hacemos, si no somos competencia.</bpmn:documentation>
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_relacion" name="3. ¿Se define la relación?">
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_acuerdo" name="Se acuerda la comisión por escrito">
      <bpmn:documentation>Si hay comisión, de cuánto y cuándo se paga. Va por escrito, no de palabra.</bpmn:documentation>
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_registra" name="4. Se registra el origen">
      <bpmn:documentation>Cada cliente nuevo anota de dónde vino. Sin esto no se sabe qué aliado funciona.</bpmn:documentation>
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_llega" name="6. Llega el prospecto">
      <bpmn:documentation>El aliado manda el contacto. Se trata como cliente normal.</bpmn:documentation>
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_embudo" name="7. Seguimiento comercial">
      <bpmn:documentation>Entra al embudo normal. Se cotiza, se negocia. Se cierra o se pierde.</bpmn:documentation>
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_cierra" name="¿Se cerró?">
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:outgoing>sf_9</bpmn:outgoing>
      <bpmn:outgoing>sf_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_reporta" name="8. Se reporta al aliado">
      <bpmn:documentation>Si hay comisión, se reporta y se paga lo acordado. Cierra el ciclo.</bpmn:documentation>
      <bpmn:incoming>sf_9</bpmn:incoming>
      <bpmn:outgoing>sf_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e_fin" name="Alianza que produce">
      <bpmn:incoming>sf_10</bpmn:incoming>
      <bpmn:incoming>sf_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="do_d_alianzas"/>
    <bpmn:dataObjectReference id="d_alianzas" dataObjectRef="do_d_alianzas" name="ALIANZAS.md">
      <bpmn:documentation>La función existe en el organigrama. Los aliados registrados, no.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:sequenceFlow id="sf_1" sourceRef="e_ini" targetRef="t_valida"/>
    <bpmn:sequenceFlow id="sf_2" sourceRef="t_valida" targetRef="g_relacion"/>
    <bpmn:sequenceFlow id="sf_3" sourceRef="g_relacion" targetRef="t_acuerdo" name="no: hay que escribirlo"/>
    <bpmn:sequenceFlow id="sf_4" sourceRef="g_relacion" targetRef="t_registra" name="sí: hay acuerdo"/>
    <bpmn:sequenceFlow id="sf_5" sourceRef="t_acuerdo" targetRef="t_registra"/>
    <bpmn:sequenceFlow id="sf_6" sourceRef="t_registra" targetRef="t_llega"/>
    <bpmn:sequenceFlow id="sf_7" sourceRef="t_llega" targetRef="t_embudo"/>
    <bpmn:sequenceFlow id="sf_8" sourceRef="t_embudo" targetRef="g_cierra"/>
    <bpmn:sequenceFlow id="sf_9" sourceRef="g_cierra" targetRef="t_reporta" name="sí"/>
    <bpmn:sequenceFlow id="sf_10" sourceRef="g_cierra" targetRef="e_fin" name="no: se perdió"/>
    <bpmn:sequenceFlow id="sf_11" sourceRef="t_reporta" targetRef="e_fin"/>
    <bpmn:association id="as_1" sourceRef="d_alianzas" targetRef="g_relacion" associationDirection="One">
      <bpmn:documentation>el modelo</bpmn:documentation>
    </bpmn:association>
    <bpmn:textAnnotation id="nota_1">
      <bpmn:text>SE TRABA AQUÍ: la comisión no está escrita. Sin acuerdo escrito, un aliado trae clientes y no se le paga: se pierde la relación y la confianza.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_1" sourceRef="nota_1" targetRef="g_relacion"/>
    <bpmn:textAnnotation id="nota_2">
      <bpmn:text>HUECO: no hay ningún aliado con acuerdo escrito. El pipeline de CLIENTE_D y CLIENTE_B no tiene origen registrado.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_2" sourceRef="nota_2" targetRef="d_alianzas"/>
    <bpmn:textAnnotation id="nota_3">
      <bpmn:text>El origen es dato, no opinión. Si no se anota de dónde vino el cliente, no hay forma de saber qué aliado funciona y cuál no.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_3" sourceRef="nota_3" targetRef="t_registra"/>
    <bpmn:textAnnotation id="nota_4">
      <bpmn:text>No se promete lo que no está escrito. Una comisión de palabra no es una comisión.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_4" sourceRef="nota_4" targetRef="t_acuerdo"/>
  </bpmn:process>
