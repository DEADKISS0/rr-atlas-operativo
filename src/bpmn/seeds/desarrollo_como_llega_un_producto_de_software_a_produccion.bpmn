<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="def_flujo_desarrollo" targetNamespace="https://rraliados.co/bpmn" exporter="RR Aliados · bpmn_xml_v2.py" exporterVersion="2.0">
  <bpmn:collaboration id="collab_1">
    <bpmn:participant id="part_1" name="CÓMO LLEGA UN PRODUCTO DE SOFTWARE A PRODUCCIÓN" processRef="proc_flujo_desarrollo"/>
  </bpmn:collaboration>
  <bpmn:process id="proc_flujo_desarrollo" name="CÓMO LLEGA UN PRODUCTO DE SOFTWARE A PRODUCCIÓN" isExecutable="false">
    <bpmn:documentation>CÓMO LLEGA UN PRODUCTO DE SOFTWARE A PRODUCCIÓN
Diez pasos, del brief al mantenimiento. El que más se salta es el 6: la revisión del cliente, que vuelve atrás todo el trabajo. · corte 2026-09-26
Dueno del proceso: DESCONOCIDO (el spec no lo declara)
KPI: DESCONOCIDO (el spec no lo declara)
Fuente: _herramientas/esquemas_bpmn/desarrollo_como_llega_un_producto_de_software_a_produccion.json</bpmn:documentation>
    <bpmn:laneSet id="laneset_1">
      <bpmn:lane id="lane_1" name="1 · Desarrollo">
        <bpmn:flowNodeRef>e_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_brief</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_arq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_proto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_impl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_qa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_2" name="2 · El cliente">
        <bpmn:flowNodeRef>g_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ajustes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_reprueba</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_3" name="3 · Después de producción">
        <bpmn:flowNodeRef>t_deploy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_manten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_ini" name="Idea o encargo">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ed_e_ini"/>
    </bpmn:startEvent>
    <bpmn:task id="t_brief" name="1. Brief técnico">
      <bpmn:documentation>Qué hay que construir, para quién y con qué límites.</bpmn:documentation>
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
      <bpmn:property id="prop_t_brief" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="dia_1">
        <bpmn:documentation>qué hay</bpmn:documentation>
        <bpmn:sourceRef>d_apps</bpmn:sourceRef>
        <bpmn:targetRef>prop_t_brief</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t_arq" name="2. Arquitectura">
      <bpmn:documentation>Se decide cómo va armado: lenguaje, datos, despliegue.</bpmn:documentation>
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_proto" name="3. Prototipo">
      <bpmn:documentation>La primera versión que se puede tocar.</bpmn:documentation>
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_impl" name="4. Implementación">
      <bpmn:documentation>Se escribe el código real.</bpmn:documentation>
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:incoming>sf_10</bpmn:incoming>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_qa" name="5. QA interno">
      <bpmn:documentation>Se prueba antes de que lo vea el cliente.</bpmn:documentation>
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_ok" name="6. ¿Lo aprueba el cliente?">
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_ajustes" name="7. Ajustes">
      <bpmn:documentation>Se corrige lo que pidió.</bpmn:documentation>
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:outgoing>sf_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_reprueba" name="¿Pasa el QA?">
      <bpmn:incoming>sf_9</bpmn:incoming>
      <bpmn:outgoing>sf_10</bpmn:outgoing>
      <bpmn:outgoing>sf_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_deploy" name="8. Deploy">
      <bpmn:documentation>Sale a producción: Railway, Vercel o el servidor propio.</bpmn:documentation>
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:incoming>sf_11</bpmn:incoming>
      <bpmn:outgoing>sf_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_docs" name="9. Documentación técnica">
      <bpmn:documentation>Alguien que no lo escribió tiene que poder usarlo. Si esto falta, el producto se vuelve inmanejable.</bpmn:documentation>
      <bpmn:incoming>sf_12</bpmn:incoming>
      <bpmn:outgoing>sf_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_manten" name="10. Mantenimiento">
      <bpmn:documentation>Cambios, correcciones y soporte.</bpmn:documentation>
      <bpmn:incoming>sf_13</bpmn:incoming>
      <bpmn:outgoing>sf_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e_fin" name="En manos del cliente">
      <bpmn:incoming>sf_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="do_d_apps"/>
    <bpmn:dataObjectReference id="d_apps" dataObjectRef="do_d_apps" name="Los 4 productos">
      <bpmn:documentation>RR Commander (Railway, en producción) · DashWeb (Vercel) · Primer Contacto (local, sin deploy) · Match Numa (en desarrollo).</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:sequenceFlow id="sf_1" sourceRef="e_ini" targetRef="t_brief"/>
    <bpmn:sequenceFlow id="sf_2" sourceRef="t_brief" targetRef="t_arq" name="se diseña"/>
    <bpmn:sequenceFlow id="sf_3" sourceRef="t_arq" targetRef="t_proto"/>
    <bpmn:sequenceFlow id="sf_4" sourceRef="t_proto" targetRef="t_impl"/>
    <bpmn:sequenceFlow id="sf_5" sourceRef="t_impl" targetRef="t_qa"/>
    <bpmn:sequenceFlow id="sf_6" sourceRef="t_qa" targetRef="g_ok"/>
    <bpmn:sequenceFlow id="sf_7" sourceRef="g_ok" targetRef="t_ajustes" name="no: pide cambios"/>
    <bpmn:sequenceFlow id="sf_8" sourceRef="g_ok" targetRef="t_deploy" name="sí"/>
    <bpmn:sequenceFlow id="sf_9" sourceRef="t_ajustes" targetRef="g_reprueba"/>
    <bpmn:sequenceFlow id="sf_10" sourceRef="g_reprueba" targetRef="t_impl" name="no: vuelve al 4"/>
    <bpmn:sequenceFlow id="sf_11" sourceRef="g_reprueba" targetRef="t_deploy" name="sí"/>
    <bpmn:sequenceFlow id="sf_12" sourceRef="t_deploy" targetRef="t_docs"/>
    <bpmn:sequenceFlow id="sf_13" sourceRef="t_docs" targetRef="t_manten"/>
    <bpmn:sequenceFlow id="sf_14" sourceRef="t_manten" targetRef="e_fin"/>
    <bpmn:textAnnotation id="nota_1">
      <bpmn:text>ACÁ SE ATRAPA EL TRABAJO: todo vuelve al paso 4, la implementación. No hay límite de rondas escrito, así que una revisión puede devolver el desarrollo completo.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_1" sourceRef="nota_1" targetRef="g_ok"/>
    <bpmn:textAnnotation id="nota_2">
      <bpmn:text>Una regla que no se rompe: el código de producción va en su carpeta en Drive y nunca en un solo computador.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_2" sourceRef="nota_2" targetRef="t_deploy"/>
    <bpmn:textAnnotation id="nota_3">
      <bpmn:text>Decidido el 26/09: CLIENTE_B entra el 12/10 a DashWeb, que deja de ser solo dashboard y pasa a ser la plataforma de pedidos multi-sede. El código de multi-sede NO existe todavía. TODO: decidir si los números financieros se ven en la misma pantalla o se separan.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_3" sourceRef="nota_3" targetRef="d_apps"/>
  </bpmn:process>
