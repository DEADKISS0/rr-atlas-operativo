<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="def_flujo_finanzas" targetNamespace="https://rraliados.co/bpmn" exporter="RR Aliados · bpmn_xml_v2.py" exporterVersion="2.0">
  <bpmn:collaboration id="collab_1">
    <bpmn:participant id="part_1" name="CÓMO ENTRA Y SE SALE LA PLATA" processRef="proc_flujo_finanzas"/>
  </bpmn:collaboration>
  <bpmn:process id="proc_flujo_finanzas" name="CÓMO ENTRA Y SE SALE LA PLATA" isExecutable="false">
    <bpmn:documentation>CÓMO ENTRA Y SE SALE LA PLATA
La plata entra por un lado, sale por otro, y hay una ventana de 15 días donde no entra casi nada. · corte 2026-09-26
Dueno del proceso: DESCONOCIDO (el spec no lo declara)
KPI: DESCONOCIDO (el spec no lo declara)
Fuente: _herramientas/esquemas_bpmn/finanzas_como_entra_y_se_sale_la_plata.json</bpmn:documentation>
    <bpmn:laneSet id="laneset_1">
      <bpmn:lane id="lane_1" name="1 · Cobrar">
        <bpmn:flowNodeRef>e_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cotiza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_escrito</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_emite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_entra</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_2" name="2 · Registrar">
        <bpmn:flowNodeRef>g_cuadra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_revisa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_anota</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_espejo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_persigue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_informa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_3" name="3 · La ventana de caja"/>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_ini" name="El cliente pide">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ed_e_ini"/>
    </bpmn:startEvent>
    <bpmn:task id="t_cotiza" name="1. Cotiza o acuerdo">
      <bpmn:documentation>El cliente pide algo. Hay que ponerle precio.</bpmn:documentation>
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_escrito" name="2. Se pone por escrito">
      <bpmn:documentation>Contrato o soporte. Sin esto no se cobra.</bpmn:documentation>
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_emite" name="3. Se emite la cuenta">
      <bpmn:documentation>La factura o Cuenta de Cobro al cliente.</bpmn:documentation>
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_entra" name="4. Entra la plata">
      <bpmn:documentation>El cliente paga. CLIENTE_C entra [CIFRA] cada mes.</bpmn:documentation>
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_cuadra" name="5. ¿Cuadra lo que entró?">
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_revisa" name="Se revisa que cuadre">
      <bpmn:documentation>Se comprueba que la plata es la que debía.</bpmn:documentation>
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_anota" name="6. Se anota">
      <bpmn:documentation>Todo va a captura.json. En ningún otro archivo.</bpmn:documentation>
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:outgoing>sf_9</bpmn:outgoing>
      <bpmn:property id="prop_t_anota" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="dia_1">
        <bpmn:documentation>los números</bpmn:documentation>
        <bpmn:sourceRef>d_fuente</bpmn:sourceRef>
        <bpmn:targetRef>prop_t_anota</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t_espejo" name="7. Se sube al espejo">
      <bpmn:documentation>sync_corte.py lo publica. El tablero solo muestra: nunca se edita a mano.</bpmn:documentation>
      <bpmn:incoming>sf_9</bpmn:incoming>
      <bpmn:outgoing>sf_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_persigue" name="8. Se persigue lo que falta">
      <bpmn:documentation>Quién debe y desde cuándo. Cartera vencida hoy: [CIFRA]</bpmn:documentation>
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:outgoing>sf_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_informa" name="9. Se informa">
      <bpmn:documentation>Reporte semanal de cartera.</bpmn:documentation>
      <bpmn:incoming>sf_10</bpmn:incoming>
      <bpmn:incoming>sf_12</bpmn:incoming>
      <bpmn:outgoing>sf_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e_fin" name="Cerrado el ciclo">
      <bpmn:incoming>sf_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="do_d_ventana"/>
    <bpmn:dataObjectReference id="d_ventana" dataObjectRef="do_d_ventana" name="La ventana de 15 días">
      <bpmn:documentation>27/09 caja en cero · 30/09 -[CIFRA] · 14/10 -[CIFRA] · 15/10 entra CLIENTE_A. Del 16/02 el colchón es [CIFRA] y sin CLIENTE_A son -[CIFRA]/mes: se acaba en julio 2027.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataStoreReference id="d_fuente" name="captura.json">
      <bpmn:documentation>Almacén · la única fuente de los números.</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="sf_1" sourceRef="e_ini" targetRef="t_cotiza"/>
    <bpmn:sequenceFlow id="sf_2" sourceRef="t_cotiza" targetRef="t_escrito" name="se formaliza"/>
    <bpmn:sequenceFlow id="sf_3" sourceRef="t_escrito" targetRef="t_emite" name="se factura"/>
    <bpmn:sequenceFlow id="sf_4" sourceRef="t_emite" targetRef="t_entra"/>
    <bpmn:sequenceFlow id="sf_5" sourceRef="t_entra" targetRef="g_cuadra"/>
    <bpmn:sequenceFlow id="sf_6" sourceRef="g_cuadra" targetRef="t_revisa" name="sí"/>
    <bpmn:sequenceFlow id="sf_7" sourceRef="g_cuadra" targetRef="t_persigue" name="no: falta plata"/>
    <bpmn:sequenceFlow id="sf_8" sourceRef="t_revisa" targetRef="t_anota"/>
    <bpmn:sequenceFlow id="sf_9" sourceRef="t_anota" targetRef="t_espejo" name="se publica"/>
    <bpmn:sequenceFlow id="sf_10" sourceRef="t_persigue" targetRef="t_informa"/>
    <bpmn:sequenceFlow id="sf_11" sourceRef="t_informa" targetRef="e_fin"/>
    <bpmn:sequenceFlow id="sf_12" sourceRef="t_espejo" targetRef="t_informa" name="y se reporta"/>
    <bpmn:association id="as_1" sourceRef="d_ventana" targetRef="g_cuadra" associationDirection="One">
      <bpmn:documentation>el riesgo</bpmn:documentation>
    </bpmn:association>
    <bpmn:textAnnotation id="nota_1">
      <bpmn:text>REGLA ROJA: cobrar antes de firmar es el error más caro que hay. Acá se pierde plata.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_1" sourceRef="nota_1" targetRef="t_emite"/>
    <bpmn:textAnnotation id="nota_2">
      <bpmn:text>Corrección 2026-09-26: este paso decía «3 de 17 Cuentas de Cobro sin firmar por [CIFRA]». Esas 20 Cuentas de Cobro son cuentas POR PAGAR a colaboradores, no cartera de clientes. La cartera vencida de RR Aliados es [CIFRA] Ver 03_09_flujo_pago_colaborador.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_2" sourceRef="nota_2" targetRef="t_persigue"/>
    <bpmn:textAnnotation id="nota_3">
      <bpmn:text>LA BOMBA REAL NO ES OCTUBRE, ES MARZO DE 2027. CLIENTE_A paga hasta el 15/02/2027 y CLIENTE_C hasta el 30/01/2027 (captura.json, corte 2026-09-26). DESPUES de esas fechas entra 0 y salen [CIFRA] al mes (burn [CIFRA] + ARL [CIFRA] + IA [CIFRA] + tarjeta [CIFRA]). El burn no se puede reducir. Hay que decidirlo antes, no en marzo.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_3" sourceRef="nota_3" targetRef="d_ventana"/>
    <bpmn:textAnnotation id="nota_4">
      <bpmn:text>A quién se le pregunta: Legal por el contrato, Dirección por la aprobación.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_4" sourceRef="nota_4" targetRef="t_espejo"/>
  </bpmn:process>
