<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="def_flujo_quincena" targetNamespace="https://rraliados.co/bpmn" exporter="RR Aliados · bpmn_xml_v2.py" exporterVersion="2.0">
  <bpmn:collaboration id="collab_1">
    <bpmn:participant id="part_1" name="LA QUINCENA" processRef="proc_flujo_quincena"/>
  </bpmn:collaboration>
  <bpmn:process id="proc_flujo_quincena" name="LA QUINCENA" isExecutable="false">
    <bpmn:documentation>LA QUINCENA
Lo que entra, lo que sale y si alcanza. Sale de captura.json · corte 2026-09-26
Dueno del proceso: DESCONOCIDO (el spec no lo declara)
KPI: DESCONOCIDO (el spec no lo declara)
Fuente: _herramientas/esquemas_bpmn/finanzas_la_quincena.json</bpmn:documentation>
    <bpmn:laneSet id="laneset_1">
      <bpmn:lane id="lane_1" name="1 · Lo que entra (clientes)">
        <bpmn:flowNodeRef>e_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_abre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cliente_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cliente_c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_cierra</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_2" name="2 · Lo que sale (RR Aliados)">
        <bpmn:flowNodeRef>t_burn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fijos</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_3" name="3 · La decisión de caja">
        <bpmn:flowNodeRef>g_alcanza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_4" name="4 · La fuente"/>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_ini" name="Día 15">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ed_e_ini"/>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="g_abre">
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:incoming>sf_13</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="t_cliente_a" name="Entra CLIENTE_A">
      <bpmn:documentation>[CIFRA] el 15/10 (2 meses). Luego [CIFRA]/mes hasta febrero. Contrato sin firmar.</bpmn:documentation>
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_cand" name="Entra CLIENTE_B">
      <bpmn:documentation>[CIFRA]/mes, del 15/10/2026 al 15/05/2027.</bpmn:documentation>
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_cliente_c" name="Entra CLIENTE_C">
      <bpmn:documentation>[CIFRA]/mes. Contrato sin firmar.</bpmn:documentation>
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="g_cierra">
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="t_burn" name="Sale el burn operativo">
      <bpmn:documentation>[CIFRA] cada 15 días. Es lo que sostiene la quincena completa.</bpmn:documentation>
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:outgoing>sf_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_fijos" name="Se pagan los fijos">
      <bpmn:documentation>ARL [CIFRA] · IA [CIFRA] · Tarjeta [CIFRA] (día 14) · Nómina [CIFRA] (atrasada del 31/08).</bpmn:documentation>
      <bpmn:incoming>sf_9</bpmn:incoming>
      <bpmn:outgoing>sf_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_alcanza" name="¿Alcanzó el saldo?">
      <bpmn:incoming>sf_10</bpmn:incoming>
      <bpmn:outgoing>sf_11</bpmn:outgoing>
      <bpmn:outgoing>sf_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_ok" name="Se repite en 15 días">
      <bpmn:documentation>El ciclo da positivo mientras entre CLIENTE_A.</bpmn:documentation>
      <bpmn:incoming>sf_11</bpmn:incoming>
      <bpmn:outgoing>sf_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_no" name="Buscar cobertura">
      <bpmn:documentation>Del 15/03 al 15/05/2027 entra solo CLIENTE_B ([CIFRA]). Ahí se cae.</bpmn:documentation>
      <bpmn:incoming>sf_12</bpmn:incoming>
      <bpmn:outgoing>sf_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e_fin" name="Cierra la quincena">
      <bpmn:incoming>sf_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="d_captura" name="captura.json">
      <bpmn:documentation>Almacén · de aquí salen todos los números.</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="sf_1" sourceRef="e_ini" targetRef="g_abre"/>
    <bpmn:sequenceFlow id="sf_2" sourceRef="g_abre" targetRef="t_cliente_a"/>
    <bpmn:sequenceFlow id="sf_3" sourceRef="g_abre" targetRef="t_cand"/>
    <bpmn:sequenceFlow id="sf_4" sourceRef="g_abre" targetRef="t_cliente_c"/>
    <bpmn:sequenceFlow id="sf_5" sourceRef="t_cliente_a" targetRef="g_cierra"/>
    <bpmn:sequenceFlow id="sf_6" sourceRef="t_cand" targetRef="g_cierra"/>
    <bpmn:sequenceFlow id="sf_7" sourceRef="t_cliente_c" targetRef="g_cierra"/>
    <bpmn:sequenceFlow id="sf_8" sourceRef="g_cierra" targetRef="t_burn" name="y sale"/>
    <bpmn:sequenceFlow id="sf_9" sourceRef="t_burn" targetRef="t_fijos"/>
    <bpmn:sequenceFlow id="sf_10" sourceRef="t_fijos" targetRef="g_alcanza"/>
    <bpmn:sequenceFlow id="sf_11" sourceRef="g_alcanza" targetRef="t_ok" name="sí"/>
    <bpmn:sequenceFlow id="sf_12" sourceRef="g_alcanza" targetRef="t_no" name="no"/>
    <bpmn:sequenceFlow id="sf_13" sourceRef="t_ok" targetRef="g_abre" name="a los 15 días, de nuevo"/>
    <bpmn:sequenceFlow id="sf_14" sourceRef="t_no" targetRef="e_fin"/>
    <bpmn:association id="as_1" sourceRef="d_captura" targetRef="g_alcanza" associationDirection="One">
      <bpmn:documentation>los números</bpmn:documentation>
    </bpmn:association>
    <bpmn:textAnnotation id="nota_1">
      <bpmn:text>La quincena en una línea: entra [CIFRA] al mes (CLIENTE_A [CIFRA] + CLIENTE_B [CIFRA] + CLIENTE_C [CIFRA]) y sale [CIFRA]. Da positivo hasta febrero. Del 15/03 al 15/05/2027 entra solo CLIENTE_B: ahí se cae.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_1" sourceRef="nota_1" targetRef="t_burn"/>
    <bpmn:textAnnotation id="nota_2">
      <bpmn:text>Las 3 Cuentas de Cobro sin firmar por [CIFRA] NO son entradas de caja: son cuentas por pagar de RR Aliados a colaboradores (PERSONA_4, PERSONA_3, PERSONA_2). Van en el flujo de pago a colaboradores, no en este.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_2" sourceRef="nota_2" targetRef="g_cierra"/>
    <bpmn:textAnnotation id="nota_3">
      <bpmn:text>Retención de ICA del 11/09: la contadora no ha confirmado si se pagó. Si no se pagó hay mora con intereses, y ese monto no está en ningún cálculo de caja.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_3" sourceRef="nota_3" targetRef="t_fijos"/>
    <bpmn:textAnnotation id="nota_4">
      <bpmn:text>Sueldo de EQUIPO_3: sin confirmar. La contadora no lo tiene claro. Sale de los [CIFRA] de producción y hoy no sube el burn.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_4" sourceRef="nota_4" targetRef="t_burn"/>
    <bpmn:textAnnotation id="nota_5">
      <bpmn:text>CLIENTE_B paga el 12/10: entra un día después del fondo (15/10) y no cubre octubre.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_5" sourceRef="nota_5" targetRef="t_cand"/>
  </bpmn:process>
