<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="def_flujo_post_venta" targetNamespace="https://rraliados.co/bpmn" exporter="RR Aliados · bpmn_xml_v2.py" exporterVersion="2.0">
  <bpmn:collaboration id="collab_1">
    <bpmn:participant id="part_1" name="QUÉ PASA DESPUÉS DE ENTREGAR" processRef="proc_flujo_post_venta"/>
  </bpmn:collaboration>
  <bpmn:process id="proc_flujo_post_venta" name="QUÉ PASA DESPUÉS DE ENTREGAR" isExecutable="false">
    <bpmn:documentation>QUÉ PASA DESPUÉS DE ENTREGAR
Etapas 09, 10 y 12 del embudo. La parte que casi nadie escribe. · corte 2026-09-26
Dueno del proceso: DESCONOCIDO (el spec no lo declara)
KPI: DESCONOCIDO (el spec no lo declara)
Fuente: _herramientas/esquemas_bpmn/clientes_que_pasa_despues_de_entregar.json</bpmn:documentation>
    <bpmn:laneSet id="laneset_1">
      <bpmn:lane id="lane_1" name="1 · Con el cliente vivo">
        <bpmn:flowNodeRef>e_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_informe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_vida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_seva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_2" name="2 · Cuando algo falla">
        <bpmn:flowNodeRef>g_falla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_escala</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_garantia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_garantia</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_ini" name="Se entregó la pieza">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t_informe" name="6. Informe mensual">
      <bpmn:documentation>Etapa 09: qué se reporta al cliente. Con CLIENTE_A son 4 informes de nov a feb, uno cada mes.</bpmn:documentation>
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_post" name="7. Post mortem">
      <bpmn:documentation>Etapa 10: qué se aprende de cada trabajo, para el siguiente. HOY NO HAY NINGUNO. El aprendizaje se queda en la cabeza de quien hizo el trabajo.</bpmn:documentation>
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_falla" name="8. ¿Algo sale mal?">
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_escala" name="Se escala">
      <bpmn:documentation>Etapa 12. No hay SLA de soporte: decir 'alta' no significa nada porque no hay tiempos definidos.</bpmn:documentation>
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_garantia" name="9. ¿Garantía o reclamo?">
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_garantia" name="Se define la garantía">
      <bpmn:documentation>No hay política escrita: qué se corrige, qué no, y quién lo decide.</bpmn:documentation>
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:outgoing>sf_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_vida" name="10. ¿El cliente sigue?">
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:outgoing>sf_9</bpmn:outgoing>
      <bpmn:outgoing>sf_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_seva" name="11. Se registra por qué se fue">
      <bpmn:documentation>Por qué se fue, qué faltó. HOY NO SE REGISTRA. La carpeta ex_clientes existe, el motivo no.</bpmn:documentation>
      <bpmn:incoming>sf_9</bpmn:incoming>
      <bpmn:outgoing>sf_11</bpmn:outgoing>
      <bpmn:property id="prop_t_seva" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="dia_1">
        <bpmn:documentation>quiénes se fueron</bpmn:documentation>
        <bpmn:sourceRef>d_ex</bpmn:sourceRef>
        <bpmn:targetRef>prop_t_seva</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="e_fin" name="Ciclo de postventa">
      <bpmn:incoming>sf_10</bpmn:incoming>
      <bpmn:incoming>sf_11</bpmn:incoming>
      <bpmn:incoming>sf_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="do_d_ex"/>
    <bpmn:dataObjectReference id="d_ex" dataObjectRef="do_d_ex" name="ex_clientes.md">
      <bpmn:documentation>Siraitia: no debe nada, no es cliente. Alma: ex cliente. 5 personas en la lista, sin motivo registrado.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:sequenceFlow id="sf_1" sourceRef="e_ini" targetRef="t_informe"/>
    <bpmn:sequenceFlow id="sf_2" sourceRef="t_informe" targetRef="t_post"/>
    <bpmn:sequenceFlow id="sf_3" sourceRef="t_post" targetRef="g_falla"/>
    <bpmn:sequenceFlow id="sf_4" sourceRef="g_falla" targetRef="t_escala" name="sí"/>
    <bpmn:sequenceFlow id="sf_5" sourceRef="g_falla" targetRef="g_vida" name="no"/>
    <bpmn:sequenceFlow id="sf_6" sourceRef="t_escala" targetRef="g_garantia"/>
    <bpmn:sequenceFlow id="sf_7" sourceRef="g_garantia" targetRef="t_garantia" name="reclamo"/>
    <bpmn:sequenceFlow id="sf_8" sourceRef="g_garantia" targetRef="g_vida" name="no era reclamo"/>
    <bpmn:sequenceFlow id="sf_9" sourceRef="g_vida" targetRef="t_seva" name="no: se fue"/>
    <bpmn:sequenceFlow id="sf_10" sourceRef="g_vida" targetRef="e_fin" name="sí: sigue"/>
    <bpmn:sequenceFlow id="sf_11" sourceRef="t_seva" targetRef="e_fin"/>
    <bpmn:sequenceFlow id="sf_12" sourceRef="t_garantia" targetRef="e_fin"/>
    <bpmn:textAnnotation id="nota_1">
      <bpmn:text>SIN POST MORTEM NO HAY APRENDIZAJE: cada trabajo debería dejar una nota de qué funcionó y qué no. No hay ninguno. El aprendizaje vive en la cabeza del que hizo el trabajo, y ese se va.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_1" sourceRef="nota_1" targetRef="t_post"/>
    <bpmn:textAnnotation id="nota_2">
      <bpmn:text>SIN SLA NO HAY SOPORTE (el hueco 7): decir 'alta' no significa nada porque no hay tiempos definidos. Y sin SLA no hay garantía: no se sabe qué se responde en cuánto tiempo.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_2" sourceRef="nota_2" targetRef="t_escala"/>
    <bpmn:textAnnotation id="nota_3">
      <bpmn:text>Aquí no hay SLA, no hay garantía y no hay post mortem. Un cliente que lleva un año pagando no tiene un solo documento de cómo se lo atiende.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_3" sourceRef="nota_3" targetRef="t_informe"/>
  </bpmn:process>
