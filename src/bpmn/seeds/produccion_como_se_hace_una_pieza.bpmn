<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="def_flujo_produccion" targetNamespace="https://rraliados.co/bpmn" exporter="RR Aliados · bpmn_xml_v2.py" exporterVersion="2.0">
  <bpmn:collaboration id="collab_1">
    <bpmn:participant id="part_1" name="CÓMO SE HACE UNA PIEZA" processRef="proc_flujo_produccion"/>
  </bpmn:collaboration>
  <bpmn:process id="proc_flujo_produccion" name="CÓMO SE HACE UNA PIEZA" isExecutable="false">
    <bpmn:documentation>CÓMO SE HACE UNA PIEZA
Del encargo del cliente hasta la entrega. Lo que hay hoy, sin adornos. · corte 2026-09-26
Dueno del proceso: DESCONOCIDO (el spec no lo declara)
KPI: DESCONOCIDO (el spec no lo declara)
Fuente: _herramientas/esquemas_bpmn/produccion_como_se_hace_una_pieza.json</bpmn:documentation>
    <bpmn:laneSet id="laneset_1">
      <bpmn:lane id="lane_1" name="1 · Lo que hace EQUIPO_2">
        <bpmn:flowNodeRef>e_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ideas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_guiones</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_prepara</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_consigue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_graba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_edita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_revisa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_2" name="2 · La decisión del cliente">
        <bpmn:flowNodeRef>g_aprueba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_brief</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_3" name="3 · Entrega y medición">
        <bpmn:flowNodeRef>t_entrega</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_mide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_que</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_ini" name="Llega el encargo">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ed_e_ini"/>
    </bpmn:startEvent>
    <bpmn:task id="t_ideas" name="2. Se buscan ideas">
      <bpmn:documentation>Se llenan ideas distintas. No una sola idea.</bpmn:documentation>
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_guiones" name="3. Se escribe">
      <bpmn:documentation>Los guiones o conceptos de cada idea.</bpmn:documentation>
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_aprueba" name="4. ¿El cliente aprueba?">
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_brief" name="1. Brief: qué es y para qué">
      <bpmn:documentation>El cliente dice qué quiere. Sin brief escrito no hay nada que hacer.</bpmn:documentation>
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_prepara" name="5. Se prepara">
      <bpmn:documentation>Se cuadra cómo se va a grabar: dónde, con quién, qué se necesita.</bpmn:documentation>
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
      <bpmn:property id="prop_t_prepara" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="dia_1">
        <bpmn:documentation>el criterio</bpmn:documentation>
        <bpmn:sourceRef>d_prod</bpmn:sourceRef>
        <bpmn:targetRef>prop_t_prepara</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t_consigue" name="6. Se consigue">
      <bpmn:documentation>Modelos, cámaras, luz, locación. EQUIPO_2 lleva esta parte hoy.</bpmn:documentation>
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_graba" name="7. Se graba">
      <bpmn:documentation>El día de grabación.</bpmn:documentation>
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:outgoing>sf_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_edita" name="8. Se edita">
      <bpmn:documentation>Se une, se corta, se colorea, se le pone música o texto.</bpmn:documentation>
      <bpmn:incoming>sf_9</bpmn:incoming>
      <bpmn:outgoing>sf_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_revisa" name="9. Se revisa">
      <bpmn:documentation>Se mira con calma antes de salir.</bpmn:documentation>
      <bpmn:incoming>sf_10</bpmn:incoming>
      <bpmn:outgoing>sf_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_entrega" name="10. Se entrega">
      <bpmn:documentation>Se publica o se le entrega al cliente.</bpmn:documentation>
      <bpmn:incoming>sf_11</bpmn:incoming>
      <bpmn:outgoing>sf_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_mide" name="11. Se mira qué pasó">
      <bpmn:documentation>Cuántas personas lo vieron, cuántos les gustó.</bpmn:documentation>
      <bpmn:incoming>sf_12</bpmn:incoming>
      <bpmn:outgoing>sf_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_que" name="12. ¿Y después qué?">
      <bpmn:documentation>No hay un número que diga si una publicación estuvo bien o mal. Sin eso el último paso no se puede evaluar.</bpmn:documentation>
      <bpmn:incoming>sf_13</bpmn:incoming>
      <bpmn:outgoing>sf_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e_fin" name="Ciclo cerrado">
      <bpmn:incoming>sf_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="do_d_prod"/>
    <bpmn:dataObjectReference id="d_prod" dataObjectRef="do_d_prod" name="PRODUCCION.md">
      <bpmn:documentation>Lo que la función sí tiene escrito.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:sequenceFlow id="sf_1" sourceRef="e_ini" targetRef="t_ideas"/>
    <bpmn:sequenceFlow id="sf_2" sourceRef="t_ideas" targetRef="t_guiones"/>
    <bpmn:sequenceFlow id="sf_3" sourceRef="t_guiones" targetRef="g_aprueba"/>
    <bpmn:sequenceFlow id="sf_4" sourceRef="g_aprueba" targetRef="t_brief" name="no: falta el brief"/>
    <bpmn:sequenceFlow id="sf_5" sourceRef="g_aprueba" targetRef="t_prepara" name="sí: así lo quiero"/>
    <bpmn:sequenceFlow id="sf_6" sourceRef="t_brief" targetRef="t_ideas"/>
    <bpmn:sequenceFlow id="sf_7" sourceRef="t_prepara" targetRef="t_consigue"/>
    <bpmn:sequenceFlow id="sf_8" sourceRef="t_consigue" targetRef="t_graba"/>
    <bpmn:sequenceFlow id="sf_9" sourceRef="t_graba" targetRef="t_edita"/>
    <bpmn:sequenceFlow id="sf_10" sourceRef="t_edita" targetRef="t_revisa"/>
    <bpmn:sequenceFlow id="sf_11" sourceRef="t_revisa" targetRef="t_entrega"/>
    <bpmn:sequenceFlow id="sf_12" sourceRef="t_entrega" targetRef="t_mide"/>
    <bpmn:sequenceFlow id="sf_13" sourceRef="t_mide" targetRef="t_que"/>
    <bpmn:sequenceFlow id="sf_14" sourceRef="t_que" targetRef="e_fin"/>
    <bpmn:textAnnotation id="nota_1">
      <bpmn:text>REGLA ROJA: nada se publica sin la aprobación del cliente. Sin este paso, todo lo demás es trabajo gratis.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_1" sourceRef="nota_1" targetRef="g_aprueba"/>
    <bpmn:textAnnotation id="nota_2">
      <bpmn:text>El paso 12 no se puede responder. No hay KPI ni SLA de producción, así que nadie sabe si una publicación estuvo bien. TODO: definir el número.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_2" sourceRef="nota_2" targetRef="t_que"/>
    <bpmn:textAnnotation id="nota_3">
      <bpmn:text>No hay camarógrafo: no hay candidato, ni está vacante el cargo. "Se consigue" hoy significa que EQUIPO_2 lo resuelve como puede.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_3" sourceRef="nota_3" targetRef="t_consigue"/>
    <bpmn:textAnnotation id="nota_4">
      <bpmn:text>En 07_Produccion/ hay 12 documentos: fotos, slides y una transcripción. Ninguna pieza entregada a un cliente está documentada como proceso.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_4" sourceRef="nota_4" targetRef="d_prod"/>
  </bpmn:process>
