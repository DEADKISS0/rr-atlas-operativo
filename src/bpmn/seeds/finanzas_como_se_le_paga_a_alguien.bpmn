<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="def_flujo_pago_colaborador" targetNamespace="https://rraliados.co/bpmn" exporter="RR Aliados · bpmn_xml_v2.py" exporterVersion="2.0">
  <bpmn:collaboration id="collab_1">
    <bpmn:participant id="part_1" name="CÓMO SE LE PAGA A ALGUIEN" processRef="proc_flujo_pago_colaborador"/>
  </bpmn:collaboration>
  <bpmn:process id="proc_flujo_pago_colaborador" name="CÓMO SE LE PAGA A ALGUIEN" isExecutable="false">
    <bpmn:documentation>CÓMO SE LE PAGA A ALGUIEN
El reverso de la entrada: cómo sale un peso. Este proceso no está escrito en ninguna parte. · corte 2026-09-26
Dueno del proceso: DESCONOCIDO (el spec no lo declara)
KPI: DESCONOCIDO (el spec no lo declara)
Fuente: _herramientas/esquemas_bpmn/finanzas_como_se_le_paga_a_alguien.json</bpmn:documentation>
    <bpmn:laneSet id="laneset_1">
      <bpmn:lane id="lane_1" name="1 · El acuerdo">
        <bpmn:flowNodeRef>e_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_trabajo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_valor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_2" name="2 · El pago">
        <bpmn:flowNodeRef>t_entrega</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_emite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_firma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_firma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_paga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_ini" name="Un cliente pide algo">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ed_e_ini"/>
    </bpmn:startEvent>
    <bpmn:task id="t_trabajo" name="1. Hay un trabajo que hacer">
      <bpmn:documentation>Alguien lo hace. 5 personas con rol fijo y 2 cargos sin llenar.</bpmn:documentation>
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_valor" name="2. Se acuerda el valor">
      <bpmn:documentation>Cuánto se paga. NO hay política escrita: cada acuerdo es distinto. Nadie sabe si es por hora, por entrega o por mes.</bpmn:documentation>
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
      <bpmn:property id="prop_t_valor" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="dia_1">
        <bpmn:documentation>qué se debe</bpmn:documentation>
        <bpmn:sourceRef>d_fuente</bpmn:sourceRef>
        <bpmn:targetRef>prop_t_valor</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t_entrega" name="3. Se entrega el trabajo">
      <bpmn:documentation>Y el cliente lo aprueba. Sin aprobación no hay pago.</bpmn:documentation>
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_emite" name="4. Se emite la Cuenta de Cobro">
      <bpmn:documentation>Es RR Aliados documentando lo que le debe a su propio colaborador. 20 documentos en total.</bpmn:documentation>
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_firma" name="5. ¿La firmó?">
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_firma" name="Se persigue la firma">
      <bpmn:documentation>3 sin firmar: PERSONA_4 [CIFRA], PERSONA_3 [CIFRA], PERSONA_2 [CIFRA]. Sin seguimiento.</bpmn:documentation>
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_paga" name="Se paga">
      <bpmn:documentation>17 de 20 firmadas: [CIFRA]. 3 sin firmar: [CIFRA]. Fuente: captura.json.</bpmn:documentation>
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:outgoing>sf_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e_fin" name="Pagado">
      <bpmn:incoming>sf_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="do_d_fuente"/>
    <bpmn:dataObjectReference id="d_fuente" dataObjectRef="do_d_fuente" name="COBRANZA_FUENTE.md">
      <bpmn:documentation>Dice cuentas POR PAGAR: RR Aliados le debe a sus colaboradores. Que el documento se llame Cuenta de Cobro es el nombre del papel, no la dirección del dinero.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:sequenceFlow id="sf_1" sourceRef="e_ini" targetRef="t_trabajo"/>
    <bpmn:sequenceFlow id="sf_2" sourceRef="t_trabajo" targetRef="t_valor" name="se acuerda"/>
    <bpmn:sequenceFlow id="sf_3" sourceRef="t_valor" targetRef="t_entrega" name="se entrega"/>
    <bpmn:sequenceFlow id="sf_4" sourceRef="t_entrega" targetRef="t_emite"/>
    <bpmn:sequenceFlow id="sf_5" sourceRef="t_emite" targetRef="g_firma"/>
    <bpmn:sequenceFlow id="sf_6" sourceRef="g_firma" targetRef="t_firma" name="no"/>
    <bpmn:sequenceFlow id="sf_7" sourceRef="g_firma" targetRef="t_paga" name="sí"/>
    <bpmn:sequenceFlow id="sf_8" sourceRef="t_firma" targetRef="g_firma"/>
    <bpmn:sequenceFlow id="sf_9" sourceRef="t_paga" targetRef="e_fin"/>
    <bpmn:textAnnotation id="nota_1">
      <bpmn:text>ACÁ ESTÁ EL HUECO: el manual de roles no menciona 'colaborador', 'pago' ni 'honorario' ni una vez. Nadie sabe si los firmantes son externos o si la planta también factura.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_1" sourceRef="nota_1" targetRef="t_valor"/>
    <bpmn:textAnnotation id="nota_2">
      <bpmn:text>No hay modelo de cuánto se paga. El caso cruzado es PERSONA_1, Director Creativo de planta, que tiene Cuenta de Cobro por [CIFRA].</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_2" sourceRef="nota_2" targetRef="t_valor"/>
    <bpmn:textAnnotation id="nota_3">
      <bpmn:text>Corrección 2026-09-26: el CSV deduplicado da [CIFRA], pero la fuente canónica captura.json dice [CIFRA]. Manda la fuente; el que está mal es el lector, no la cifra.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_nota_3" sourceRef="nota_3" targetRef="t_paga"/>
  </bpmn:process>
